# API anahtarını buraya yaz, .env dosyası git'e gönderilmez
API_KEY=

# OpenAI dışında bir sağlayıcı kullanacaksan bu satırı değiştir
# Ollama için: http://localhost:11434/v1
BASE_URL=https://api.openai.com/v1

EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini

# Parçalama ayarları. Değiştirdikten sonra yeniden indeksle ve eval çalıştır.
CHUNK_SIZE=500
CHUNK_OVERLAP=80
TOP_K=4
